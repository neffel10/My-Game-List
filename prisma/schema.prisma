datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum RewardDeliveryType {
  PHYSICAL
  DIGITAL_DOWNLOAD
  DIGITAL_CODE
}

model PointAward {
  id          String   @id @default(cuid())
  userId      String
  gameId      String
  type        String
  points      Int
  availableAt DateTime
  creditedAt  DateTime?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId, type])
  @@index([userId, availableAt])
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String?
  gamertag      String    @unique
  image         String?   // URL del avatar activo actual
  rank          String    @default("NOVICE")
  totalPoints   Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  progress      UserGameProgress[]
  unlockedAvatars UserUnlockedAvatar[]
  evidences     EvidenceSubmission[]
  pointAwards   PointAward[]
  evidenceUploadQuotas DailyEvidenceUploadQuota[]
  rewardRedemptions RewardRedemption[]
  fanArtSubmissions FanArtSubmission[] @relation("FanArtSubmitter")
  fanArtVotes FanArtVote[]
}

model Franchise {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  coverImage  String
  bannerImage String?
  apiSource   String?
  createdAt   DateTime      @default(now())
  categories  Subcategory[]
  avatars     UnlockableAvatar[]
  fanArts     FanArtSubmission[]
  fanArtContests FanArtContest[]
}

model Subcategory {
  id          String     @id @default(cuid())
  title       String
  orderIndex  Int        @default(0)
  franchiseId String
  franchise   Franchise  @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  games       Game[]

  @@unique([franchiseId, title])
}

model Game {
  id                    String             @id @default(cuid())
  title                 String
  year                  Int
  rawgSlug              String?            @unique
  coverImage            String?
  releaseDate           DateTime?
  platforms             String[]           @default([])
  description           String?
  subcategoryId         String
  subcategory           Subcategory        @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  manualCategoryOverride Boolean           @default(false)
  progress              UserGameProgress[]
  rewardAvatar          UnlockableAvatar?  @relation(fields: [rewardAvatarId], references: [id])
  rewardAvatarId        String?
  pointAwards           PointAward[]
}

model GameBlacklist {
  id            String   @id @default(cuid())
  franchiseSlug String
  rawgSlug      String?
  title         String
  reason        String?
  createdAt     DateTime @default(now())

  @@index([franchiseSlug])
  @@index([rawgSlug])
  @@map("BlacklistedGame")
}

model UserGameProgress {
  id         String   @id @default(cuid())
  userId     String
  gameId     String
  completed  Boolean  @default(false)
  mastered   Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game       Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  evidence   EvidenceSubmission?

  @@unique([userId, gameId])
}

model UnlockableAvatar {
  id             String   @id @default(cuid())
  title          String   // Ej: "Captain Falcon Vintage", "Fire Mario 8-bit"
  imageUrl       String
  franchiseId    String?
  franchise      Franchise? @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  catalogKey     String?  @unique
  isFree         Boolean  @default(false)
  games          Game[]   // Desbloqueado al completar o masterizar este juego
  requiredMaster Boolean  @default(false) // Si requiere 100% o solo beat

  unlockedBy     UserUnlockedAvatar[]
}

model UserUnlockedAvatar {
  id         String           @id @default(cuid())
  userId     String
  avatarId   String
  unlockedAt DateTime         @default(now())

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatar     UnlockableAvatar @relation(fields: [avatarId], references: [id], onDelete: Cascade)

  @@unique([userId, avatarId])
}

model EvidenceSubmission {
  id         String           @id @default(cuid())
  userId     String
  progressId String           @unique
  imageUrl   String
  status     String           @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason String?
  masteryRequested Boolean    @default(false)
  masteredApproved Boolean    @default(false)
  reviewedAt DateTime?
  createdAt  DateTime         @default(now())

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress   UserGameProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)
}

model DailyEvidenceUploadQuota {
  id      String @id @default(cuid())
  userId  String
  dateKey String
  count   Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey])
  @@index([dateKey])
}

model FanArtSubmission {
  id              String   @id @default(cuid())
  franchiseId     String?
  franchise       Franchise? @relation(fields: [franchiseId], references: [id], onDelete: SetNull)
  contestId       String?
  contest         FanArtContest? @relation("ContestSubmissions", fields: [contestId], references: [id], onDelete: SetNull)
  submittedByUserId String?
  submittedBy     User? @relation("FanArtSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  title           String
  artistName      String
  imageUrl        String
  month           String
  year            Int
  reviewStatus    String   @default("APPROVED")
  rejectionReason String?
  isFeatured      Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  votes           FanArtVote[]
  winnerOf        FanArtContest? @relation("ContestWinner")

  @@index([franchiseId])
  @@index([isFeatured, isActive])
  @@index([contestId, reviewStatus, isActive])
  @@index([submittedByUserId, createdAt])
}

model FanArtContest {
  id                String   @id @default(cuid())
  franchiseId       String
  month             String
  year              Int
  status            String   @default("OPEN")
  winnerSubmissionId String? @unique
  createdAt         DateTime @default(now())
  closedAt          DateTime?
  franchise         Franchise @relation(fields: [franchiseId], references: [id], onDelete: Restrict)
  submissions       FanArtSubmission[] @relation("ContestSubmissions")
  votes             FanArtVote[]
  winner            FanArtSubmission? @relation("ContestWinner", fields: [winnerSubmissionId], references: [id], onDelete: SetNull)

  @@unique([year, month])
  @@index([status, createdAt])
}

model FanArtVote {
  id             String   @id @default(cuid())
  contestId      String
  submissionId   String
  userId         String
  createdAt      DateTime @default(now())
  contest        FanArtContest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  submission     FanArtSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId])
  @@unique([submissionId, userId])
  @@index([submissionId])
}

model Reward {
  id              String             @id @default(cuid())
  title           String
  company         String
  imageUrl        String
  description     String?
  pointsRequired  Int
  stock           Int                @default(1)
  category        String             @default("DIGITAL")
  deliveryType    RewardDeliveryType @default(PHYSICAL)
  digitalAssetUrl String?
  isActive        Boolean            @default(true)
  externalLink    String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  digitalCodes    RewardDigitalCode[]
  redemptions     RewardRedemption[]

  @@index([isActive, deliveryType])
}

model RewardRedemption {
  id            String   @id @default(cuid())
  userId        String
  rewardId      String
  pointsSpent   Int
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward        Reward   @relation(fields: [rewardId], references: [id], onDelete: Restrict)
  digitalCode   RewardDigitalCode?

  @@unique([userId, rewardId])
  @@index([userId, createdAt])
}

model RewardDigitalCode {
  id           String  @id @default(cuid())
  rewardId     String
  code         String
  redemptionId String? @unique
  reward       Reward  @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  redemption   RewardRedemption? @relation(fields: [redemptionId], references: [id], onDelete: SetNull)

  @@unique([rewardId, code])
  @@index([rewardId, redemptionId])
}

model ImportTask {
  id            String    @id @default(cuid())
  type          String
  franchiseId   String?
  franchiseName String
  status        String    @default("PENDING")
  phase         String    @default("Queued")
  progress      Int       @default(0)
  total         Int       @default(0)
  importedGames Int       @default(0)
  error         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, createdAt])
}

// Modelos estándar requeridos por NextAuth
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}